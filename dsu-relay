#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""DSU (cemuhook) relay for Cemu and Eden on a handheld.

Publishes one DSU server on 127.0.0.1:26761 with four slots at a fixed 200 Hz:

  slot 1 (index 0): main pad, gyro in real deg/s   -> Cemu
  slot 2 (index 1): main pad, gyro x 312/360       -> Eden player 1
  slot 3 (index 2): second pad, gyro x 312/360     -> Eden player 2
  slot 4 (index 3): third pad, gyro x 312/360      -> Eden player 3

(Eden divides DSU gyro values by 312 instead of 360, hence the factor on its slots.)

The motion sources are picked automatically:

  * every connected real DualSense / DualSense Edge (kernel hid-playstation "Motion Sensors" nodes),
    in the order they connect: first pad = main pad,
  * otherwise the handheld IMU, from whichever of these is available:
      - InputPlumber's virtual DualSense (target "DualSense Edge", InputPlumber 0.82 or later), which
        on the ROG Ally X reports a frame rotated 180 degrees about X compared with a real DualSense
        and is corrected here,
      - InputPlumber's virtual Steam Deck controller (the default target, InputPlumber 0.82 or later),
        read from its hidraw node, so no target change is needed and Steam Input keeps its gyro,
      - iio-dsu-bridge on 127.0.0.1:26760 (InputPlumber 0.81 or earlier, which leaves the IMU free).

So docking the handheld and turning on one or more DualSense pads switches the motion sources with no
config change in the emulators, and turning them off switches back to the handheld IMU.

Tested on ROG Ally X (BMI323): with InputPlumber 0.83 and the DualSense Edge target, and with
InputPlumber 0.81 plus the bridge config from iio-dsu-bridge issue #15
(accel_matrix x[-1,0,0] y[0,0,1] z[0,-1,0], gyro_matrix x[1,0,0] y[0,0,1] z[0,-1,0]).

Usage:
  dsu-relay                 run the relay
  dsu-relay --sources 20    print the motion sources and their slots (to check poses and pad order)
"""
import argparse
import glob
import os
import random
import select
import socket
import struct
import threading
import time
import zlib

PROTO_VERSION = 1001
MSG_VERSION = 0x00100000
MSG_INFO = 0x00100001
MSG_DATA = 0x00100002
MAC = bytes([0x02, 0x20, 0x6A, 0x7E, 0x51, 0x01])

SLOT_CEMU = 0             # main pad, gyro in deg/s, as Cemu expects
SLOT_EDEN_P1 = 1          # main pad, scaled for Eden
SLOT_EDEN_P2 = 2          # second pad
SLOT_EDEN_P3 = 3          # third pad
SLOTS = (SLOT_CEMU, SLOT_EDEN_P1, SLOT_EDEN_P2, SLOT_EDEN_P3)
GYRO_SCALE = 312.0 / 360.0

STALE_SECONDS = 0.2       # a source is "live" only while it produced samples this recently
SUB_TIMEOUT_SECONDS = 10  # Eden renews its subscription every 3 s
SCAN_SECONDS = 2.0        # how often to look for new DualSense pads
LOG_EVERY_SECONDS = 60

# DualSense motion sensors, as exposed by the kernel hid-playstation driver
DS_ACC_RES_PER_G = 8192.0
DS_GYRO_RES_PER_DEG_S = 1024.0
EV_SYN, EV_ABS = 0, 3
EVENT = struct.Struct("=qqHHi")

# Steam Deck controller state report, as read by SDL (SDL_hidapi_steamdeck.c)
DECK_VENDOR = "000028DE"
DECK_ACC_RES_PER_G = 16384.0
DECK_GYRO_RES_PER_DEG_S = 32768.0 / 2000.0
DECK_ROTATE_180_X = False  # set after checking the poses with --sources


def finish_packet(buf):
    struct.pack_into("<I", buf, 8, 0)
    struct.pack_into("<I", buf, 8, zlib.crc32(bytes(buf)) & 0xFFFFFFFF)
    return bytes(buf)


def build_packet(server_id, msg_type, payload):
    buf = bytearray(20 + len(payload))
    buf[0:4] = b"DSUS"
    struct.pack_into("<HHIII", buf, 4, PROTO_VERSION, len(payload) + 4, 0, server_id, msg_type)
    buf[20:] = payload
    return finish_packet(buf)


def build_version(server_id):
    return build_packet(server_id, MSG_VERSION, struct.pack("<H", PROTO_VERSION))


def shared_beginning(slot, state):
    return bytes([slot, state, 2, 1]) + bytes([MAC[0] + slot]) + MAC[1:] + bytes([0x05])


def build_info(server_id, slot, state):
    return build_packet(server_id, MSG_INFO, shared_beginning(slot, state) + bytes([1 if state == 2 else 0]))


def build_data(server_id, slot, counter, timestamp_us, accel, gyro):
    """Same layout as buildControllerData in iio-dsu-bridge."""
    p = bytearray(80)
    p[0:11] = shared_beginning(slot, 2)
    p[11] = 1
    struct.pack_into("<I", p, 12, counter & 0xFFFFFFFF)
    p[20:24] = bytes([128] * 4)
    struct.pack_into("<Q", p, 48, timestamp_us)
    struct.pack_into("<3f", p, 56, *accel)
    struct.pack_into("<3f", p, 68, *gyro)
    return build_packet(server_id, MSG_DATA, bytes(p))


def build_subscribe(client_id):
    body = struct.pack("<I", MSG_DATA) + bytes([0, 0]) + bytes(6)
    buf = bytearray(b"DSUC" + struct.pack("<HHII", PROTO_VERSION, len(body), 0, client_id) + body)
    return finish_packet(buf)


def parse_data(packet):
    """(slot, counter, accel_g, gyro_dps) from a DSU pad data packet, or None."""
    if len(packet) < 100 or packet[:4] != b"DSUS" or struct.unpack_from("<I", packet, 16)[0] != MSG_DATA:
        return None
    return (packet[20],
            struct.unpack_from("<I", packet, 32)[0],
            struct.unpack_from("<3f", packet, 76),
            struct.unpack_from("<3f", packet, 88))


class BridgeSource:
    """The handheld IMU, read from iio-dsu-bridge over DSU."""

    name = "handheld IMU (bridge)"

    def __init__(self, host="127.0.0.1", port=26760):
        self.address = (host, port)
        self.latest = None  # (arrival time, accel_g, gyro_dps)
        self.samples = 0

    def run(self, stop):
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.bind(("127.0.0.1", 0))
        sock.settimeout(0.2)
        subscribe = build_subscribe(random.getrandbits(32))
        last_subscribe = 0.0
        try:
            while not stop.is_set():
                now = time.monotonic()
                if now - last_subscribe >= 1.0:
                    try:
                        sock.sendto(subscribe, self.address)
                    except OSError:
                        pass
                    last_subscribe = now
                try:
                    data, _ = sock.recvfrom(2048)
                except OSError:  # timeout, or port closed while the bridge restarts
                    continue
                parsed = parse_data(data)
                if parsed:
                    _, _, accel, gyro = parsed
                    self.latest = (time.monotonic(), accel, gyro)
                    self.samples += 1
        finally:
            sock.close()


def ds_to_dsu(values, res):
    """One DualSense report to the DSU convention used by the bridge.

    Accel is negated and the gyro keeps x while y and z flip, which is what Cemu's DSU path
    expects (it feeds its fusion with (a.x, -a.y, -a.z)).
    """
    accel = tuple(-values[i] / res[i] for i in range(3))
    gyro = (values[3] / res[3], -values[4] / res[4], -values[5] / res[5])
    return accel, gyro


def flip_virtual(accel, gyro):
    """InputPlumber's virtual DualSense on the ROG Ally X, rotated 180 degrees about X to match a real pad.

    Measured: lying flat it reads Y +1 g and screen-up-vertical Z -1 g after ds_to_dsu, where a real
    DualSense and the bridge read Y -1 g and Z +1 g; X matches. A proper rotation, so the gyro gets the
    same correction.
    """
    return (accel[0], -accel[1], -accel[2]), (gyro[0], -gyro[1], -gyro[2])


def is_virtual_device(device_dir):
    """True for uhid devices (InputPlumber targets), False for real pads on USB or Bluetooth."""
    return "/devices/virtual/" in os.path.realpath(device_dir)


class DualSensePad:
    """One DualSense, read from its kernel 'Motion Sensors' evdev node."""

    def __init__(self, path, uniq, name, virtual=False):
        self.path = path
        self.uniq = uniq
        self.virtual = virtual
        if virtual:
            self.name = "handheld IMU (InputPlumber)"
        else:
            self.name = f"DualSense {uniq}" if uniq else "DualSense"
        self.full_name = name
        self.latest = None
        self.samples = 0

    @staticmethod
    def resolutions(fd):
        try:
            import fcntl
        except ImportError:
            return [DS_ACC_RES_PER_G] * 3 + [DS_GYRO_RES_PER_DEG_S] * 3
        out = []
        for code in range(6):
            default = DS_ACC_RES_PER_G if code < 3 else DS_GYRO_RES_PER_DEG_S
            buf = bytearray(24)
            try:
                fcntl.ioctl(fd, 0x80184540 + code, buf)
                res = struct.unpack("6i", buf)[5]
                out.append(float(res) if res > 0 else default)
            except OSError:
                out.append(default)
        return out

    def run(self, stop):
        try:
            fd = os.open(self.path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            return
        res = self.resolutions(fd)
        values = [0] * 6
        pending = b""
        try:
            while not stop.is_set():
                if not select.select([fd], [], [], 0.2)[0]:
                    continue
                chunk = os.read(fd, EVENT.size * 64)
                if not chunk:
                    break
                pending += chunk
                while len(pending) >= EVENT.size:
                    _, _, etype, code, value = EVENT.unpack_from(pending)
                    pending = pending[EVENT.size:]
                    if etype == EV_ABS and code < 6:
                        values[code] = value
                    elif etype == EV_SYN and code == 0:
                        accel, gyro = ds_to_dsu(values, res)
                        if self.virtual:
                            accel, gyro = flip_virtual(accel, gyro)
                        self.latest = (time.monotonic(), accel, gyro)
                        self.samples += 1
        except OSError:  # unplugged
            pass
        finally:
            os.close(fd)
            self.latest = None


class DualSenseManager:
    """Keeps one reader per connected DualSense, in the order the pads connect.

    Real pads always come first; InputPlumber's virtual pad (the handheld IMU) is used only when no
    real pad is sending.
    """

    def __init__(self):
        self.pads = []  # ordered: first connected first
        self.lock = threading.Lock()
        self.samples = 0

    @staticmethod
    def find_nodes():
        found = []
        for name_file in sorted(glob.glob("/sys/class/input/event*/device/name")):
            try:
                name = open(name_file).read().strip()
            except OSError:
                continue
            if "Motion Sensors" not in name or "DualSense" not in name:
                continue
            device_dir = os.path.dirname(name_file)
            try:
                uniq = open(os.path.join(device_dir, "uniq")).read().strip()
            except OSError:
                uniq = ""
            found.append(("/dev/input/" + name_file.split("/")[4], uniq, name, is_virtual_device(device_dir)))
        return found

    def live(self, now):
        with self.lock:
            pads = list(self.pads)
        fresh = [p for p in pads if p.latest and now - p.latest[0] <= STALE_SECONDS]
        real = [p for p in fresh if not getattr(p, "virtual", False)]
        return real or [p for p in fresh if getattr(p, "virtual", False)][:1]

    def run(self, stop):
        threads = {}
        while not stop.is_set():
            paths = {path: (uniq, name, virtual) for path, uniq, name, virtual in self.find_nodes()}
            with self.lock:
                known = {pad.path for pad in self.pads}
                for path, (uniq, name, virtual) in paths.items():
                    if path in known:
                        continue
                    pad = DualSensePad(path, uniq, name, virtual)
                    self.pads.append(pad)
                    thread = threading.Thread(target=pad.run, args=(stop,), daemon=True)
                    thread.start()
                    threads[path] = thread
                gone = [pad for pad in self.pads if pad.path not in paths]
                for pad in gone:
                    self.samples += pad.samples
                    self.pads.remove(pad)
                    threads.pop(pad.path, None)
            stop.wait(SCAN_SECONDS)

    def total_samples(self):
        with self.lock:
            return self.samples + sum(pad.samples for pad in self.pads)


def deck_to_dsu(ax, ay, az, gx, gy, gz):
    """One Steam Deck state report to the DSU convention used by the bridge.

    SDL reads the Deck report as accel (X, Z, -Y) at 16384 per g and gyro (X, Z, -Y) at 16.384 per deg/s
    (SDL_hidapi_steamdeck.c); from there it is the same conversion as a DualSense.
    """
    sdl_accel = (ax / DECK_ACC_RES_PER_G, az / DECK_ACC_RES_PER_G, -ay / DECK_ACC_RES_PER_G)
    sdl_gyro = (gx / DECK_GYRO_RES_PER_DEG_S, gz / DECK_GYRO_RES_PER_DEG_S, -gy / DECK_GYRO_RES_PER_DEG_S)
    accel = tuple(-v for v in sdl_accel)
    gyro = (sdl_gyro[0], -sdl_gyro[1], -sdl_gyro[2])
    if DECK_ROTATE_180_X:
        return flip_virtual(accel, gyro)
    return accel, gyro


def parse_deck_report(data):
    """(ax, ay, az, gx, gy, gz) from a Steam Deck state report (type 9), or None."""
    if len(data) < 36 or data[0] != 0x01 or data[1] != 0x00 or data[2] != 0x09 or data[3] != 64:
        return None
    return struct.unpack_from("<6h", data, 24)


class DeckSource:
    """The handheld IMU, read from InputPlumber's virtual Steam Deck controller (its hidraw node).

    This is InputPlumber's default target on Bazzite, so it needs no target change and keeps the gyro
    available to Steam Input as well. Hidraw nodes can be read by several programs at once.
    """

    name = "handheld IMU (InputPlumber Deck)"

    def __init__(self):
        self.latest = None
        self.samples = 0
        self.error = None

    @staticmethod
    def find_nodes():
        nodes = []
        for uevent in sorted(glob.glob("/sys/class/hidraw/hidraw*/device/uevent")):
            try:
                fields = dict(line.split("=", 1) for line in open(uevent).read().splitlines() if "=" in line)
            except OSError:
                continue
            parts = fields.get("HID_ID", "").split(":")
            if len(parts) == 3 and parts[1].upper() == DECK_VENDOR:
                nodes.append("/dev/" + uevent.split("/")[4])
        return nodes

    def run(self, stop):
        fds = {}
        last_scan = 0.0
        try:
            while not stop.is_set():
                now = time.monotonic()
                if now - last_scan >= SCAN_SECONDS:
                    last_scan = now
                    present = set(self.find_nodes())
                    for path in [p for p in fds if p not in present]:
                        os.close(fds.pop(path))
                    for path in present - set(fds):
                        try:
                            fds[path] = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                            self.error = None
                        except PermissionError:
                            self.error = f"permission denied on {path}"
                        except OSError:
                            pass
                if not fds:
                    stop.wait(0.5)
                    continue
                ready = select.select(list(fds.values()), [], [], 0.2)[0]
                for fd in ready:
                    try:
                        data = os.read(fd, 64)
                    except OSError:  # removed, picked up by the next scan
                        continue
                    values = parse_deck_report(data)
                    if values:
                        accel, gyro = deck_to_dsu(*values)
                        self.latest = (time.monotonic(), accel, gyro)
                        self.samples += 1
        finally:
            for fd in fds.values():
                os.close(fd)


def select_sources(dualsense, deck, bridge, now):
    """(main source, extra pads) right now.

    Real DualSense pads come first, in connection order. Without one, the handheld IMU is the main
    source, from InputPlumber's virtual DualSense, its virtual Steam Deck, or iio-dsu-bridge.
    """
    pads = dualsense.live(now)
    if pads and not getattr(pads[0], "virtual", False):
        return pads[0], pads[1:]
    for source in pads[:1] + [deck, bridge]:
        sample = source.latest
        if sample and now - sample[0] <= STALE_SECONDS:
            return source, []
    return None, []


class _Hold:
    """Placeholder source while nothing is live: slots 1 and 2 keep sending a device at rest."""

    name = "none (holding still)"


HOLD = _Hold()


class Relay:
    def __init__(self, listen_port=26761, rate=200.0, host="127.0.0.1", log=print,
                 bridge=None, dualsense=None, deck=None):
        self.rate = rate
        self.log = log
        self.server_id = random.getrandbits(32)
        self.bridge = bridge if bridge is not None else BridgeSource(host)
        self.dualsense = dualsense if dualsense is not None else DualSenseManager()
        self.deck = deck if deck is not None else DeckSource()
        self.down = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.down.bind((host, listen_port))
        self.down.settimeout(0.2)
        self.listen_port = self.down.getsockname()[1]
        self.lock = threading.Lock()
        self.subs = {}  # address -> [last renewal, {slot: counter}]
        self.stop = threading.Event()
        self.stats = {"sent": 0}
        self.layout = ""
        self.active_slots = set()
        self.last_accel = (0.0, -1.0, 0.0)  # lying flat, until a source reports
        self.threads = []

    def slot_sources(self, now):
        """{slot: (source, accel, gyro)} for the slots that currently have motion data.

        Slots 1 and 2 never go silent: while no source is live (InputPlumber recreates its virtual pad
        when a game starts, which takes a few seconds), they hold the last attitude with the gyro at
        rest. Cemu only asks for more data after it receives some, so a gap would drop it for good.
        """
        main, extra = select_sources(self.dualsense, self.deck, self.bridge, now)
        out = {}
        if main is not None:
            accel, gyro = main.latest[1], main.latest[2]
            self.last_accel = accel
            out[SLOT_CEMU] = (main, accel, gyro)
            out[SLOT_EDEN_P1] = (main, accel, tuple(g * GYRO_SCALE for g in gyro))
        else:
            out[SLOT_CEMU] = (HOLD, self.last_accel, (0.0, 0.0, 0.0))
            out[SLOT_EDEN_P1] = (HOLD, self.last_accel, (0.0, 0.0, 0.0))
        for pad, slot in zip(extra, (SLOT_EDEN_P2, SLOT_EDEN_P3)):
            out[slot] = (pad, pad.latest[1], tuple(g * GYRO_SCALE for g in pad.latest[2]))
        return out

    def _downstream_loop(self):
        while not self.stop.is_set():
            try:
                data, addr = self.down.recvfrom(2048)
            except OSError:
                continue
            if len(data) < 20 or data[:4] != b"DSUC" or struct.unpack_from("<H", data, 4)[0] != PROTO_VERSION:
                continue
            msg = struct.unpack_from("<I", data, 16)[0]
            active = set(self.active_slots)
            replies = []
            if msg in (MSG_VERSION, MSG_INFO):
                replies.append(build_version(self.server_id))
            if msg == MSG_INFO and len(data) >= 24:
                count = max(0, min(struct.unpack_from("<i", data, 20)[0], 4))
                for slot in data[24:24 + count]:
                    replies.append(build_info(self.server_id, slot, 2 if slot in active else 0))
            elif msg == MSG_DATA and len(data) >= 28:
                flags, slot = data[20], data[21]
                wanted = set(SLOTS) if flags == 0 else ({slot} & set(SLOTS) if flags & 0x01 else set())
                if wanted:
                    with self.lock:
                        entry = self.subs.setdefault(addr, [0.0, {}])
                        entry[0] = time.monotonic()
                        new_slots = wanted - set(entry[1])
                        for s in new_slots:
                            entry[1][s] = 0
                    # Answer only new subscriptions: Cemu re-requests after every message it receives,
                    # so replying to each renewal would start a request/reply ping-pong.
                    for s in sorted(new_slots & active):
                        replies.append(build_info(self.server_id, s, 2))
            for reply in replies:
                try:
                    self.down.sendto(reply, addr)
                except OSError:
                    pass

    def _emit_loop(self):
        period = 1.0 / self.rate
        next_tick = time.monotonic()
        last_info = 0.0
        while not self.stop.is_set():
            now = time.monotonic()
            if now < next_tick:
                time.sleep(next_tick - now)
                continue
            next_tick += period
            if now - next_tick > 0.05:  # fell behind (e.g. suspend): restart the schedule from now
                next_tick = now + period

            sources = self.slot_sources(now)
            self.active_slots = set(sources)
            layout = ", ".join(f"slot {slot + 1}: {src.name}" for slot, (src, _, _) in sorted(sources.items()))
            if layout != self.layout:
                self.log(f"motion sources -> {layout or 'none'}")
                self.layout = layout

            with self.lock:
                for addr in [a for a, e in self.subs.items() if now - e[0] > SUB_TIMEOUT_SECONDS]:
                    del self.subs[addr]
                targets = []
                for addr, entry in self.subs.items():
                    for slot in sorted(entry[1]):
                        if slot in sources:
                            entry[1][slot] += 1
                            targets.append((addr, slot, entry[1][slot]))
                infos = list(self.subs) if now - last_info >= 0.5 else []
            if infos:
                last_info = now

            timestamp_us = int(now * 1_000_000)
            for addr, slot, counter in targets:
                _, accel, gyro = sources[slot]
                try:
                    self.down.sendto(build_data(self.server_id, slot, counter, timestamp_us, accel, gyro), addr)
                    self.stats["sent"] += 1
                except OSError:
                    pass
            for addr in infos:
                for slot in sorted(sources):
                    try:
                        self.down.sendto(build_info(self.server_id, slot, 2), addr)
                    except OSError:
                        pass

    def start(self):
        for target in (lambda: self.bridge.run(self.stop),
                       lambda: self.dualsense.run(self.stop),
                       lambda: self.deck.run(self.stop),
                       self._downstream_loop,
                       self._emit_loop):
            thread = threading.Thread(target=target, daemon=True)
            thread.start()
            self.threads.append(thread)

    def close(self):
        self.stop.set()
        for thread in self.threads:
            thread.join(timeout=1)
        self.down.close()

    def run(self, seconds=0):
        self.start()
        self.log(f"DSU relay on 127.0.0.1:{self.listen_port} at {self.rate:g} Hz "
                 f"(slot 1 = Cemu, slots 2-4 = Eden players 1-3)")
        start = last_log = time.monotonic()
        def counters():
            return dict(self.stats, bridge=self.bridge.samples, deck=self.deck.samples,
                        dualsense=self.dualsense.total_samples())

        last = counters()
        try:
            while not seconds or time.monotonic() - start < seconds:
                time.sleep(0.2)
                now = time.monotonic()
                if now - last_log >= LOG_EVERY_SECONDS:
                    window = now - last_log
                    with self.lock:
                        subs = len(self.subs)
                    current = counters()
                    rate = {k: (current[k] - last[k]) / window for k in current}
                    self.log(f"{self.layout or 'no source'} | deck {rate['deck']:.0f}/s, "
                             f"dualsense {rate['dualsense']:.0f}/s, bridge {rate['bridge']:.0f}/s, "
                             f"sent {rate['sent']:.0f}/s, subscribers {subs}"
                             + (f" | {self.deck.error}" if self.deck.error else ""))
                    last = current
                    last_log = now
        except KeyboardInterrupt:
            pass
        finally:
            self.close()


def show_sources(seconds, log=print):
    """Print every motion source with its slot, once per second."""
    stop = threading.Event()
    bridge, pads, deck = BridgeSource(), DualSenseManager(), DeckSource()
    threads = [threading.Thread(target=s.run, args=(stop,), daemon=True) for s in (bridge, pads, deck)]
    for thread in threads:
        thread.start()
    log("slot | source                  | accel g            | gyro deg/s")
    end = time.monotonic() + seconds
    try:
        while time.monotonic() < end:
            time.sleep(1.0)
            now = time.monotonic()
            main, extra = select_sources(pads, deck, bridge, now)
            rows = [("1+2", main.name, main.latest)] if main else []
            for index, pad in enumerate(extra[:2], start=3):
                rows.append((str(index), pad.name, pad.latest))
            if deck.error:
                log(f"note: {deck.error}")
            if not rows:
                log("no motion source")
            for slot, name, sample in rows:
                _, accel, gyro = sample
                log(f"{slot:4} | {name:23} | {accel[0]:6.2f} {accel[1]:6.2f} {accel[2]:6.2f} |"
                    f" {gyro[0]:7.1f} {gyro[1]:7.1f} {gyro[2]:7.1f}")
            log("")
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        for thread in threads:
            thread.join(timeout=1)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--listen-port", type=int, default=26761)
    parser.add_argument("--rate", type=float, default=200.0)
    parser.add_argument("--sources", type=float, metavar="SECONDS",
                        help="print the motion sources and their slots instead of running the relay")
    args = parser.parse_args()
    log = lambda text: print(text, flush=True)
    if args.sources:
        show_sources(args.sources, log=log)
        return
    Relay(args.listen_port, args.rate, log=log).run()


if __name__ == "__main__":
    main()
